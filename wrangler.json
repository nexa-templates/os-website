{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexa-os-website",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "vars": {
    "PREVIEW_MODE": "false",
    "ACCESS_ISSUER": "",
    "ACCESS_AUD": "",
    "APP_ORIGIN": "",
    "ACCESS_PATHS": "/editor,/preview,/api/sites"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SITES",
        "class_name": "Website"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "Website"
      ]
    }
  ],
  "ratelimits": [
    {
      "name": "CREATION_LIMIT",
      "namespace_id": "8672201",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "CONTACT_LIMIT",
      "namespace_id": "8672202",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "preview_urls": false,
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
