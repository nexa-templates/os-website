---
import { env } from 'cloudflare:workers';
import SitePage from '../components/SitePage.astro';
import NotFound from '../components/NotFound.astro';
const id = env.SITE_ID;
const site = id && /^[a-f0-9]{32}$/.test(id) ? await env.SITES.getByName(id).readPublic() : null;
const page = site?.document.pages.find(page => page.slug === Astro.params.slug);
if (!page) Astro.response.status = 404;
---
{page ? <SitePage document={site.document} page={page} siteID={id} /> : <NotFound />}
