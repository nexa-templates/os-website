{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nexa-website-template",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": { "bindings": [{ "name": "SITES", "class_name": "Website" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Website"] }],
  "ratelimits": [
    { "name": "CREATION_LIMIT", "namespace_id": "8672201", "simple": { "limit": 10, "period": 60 } },
    { "name": "CONTACT_LIMIT", "namespace_id": "8672202", "simple": { "limit": 5, "period": 60 } }
  ]
}
