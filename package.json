{
  "name": "@nexa-os-templates/website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "npm": ">=9.6.5"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1",
    "deploy": "wrangler deploy",
    "test": "node --test tests/access.test.mjs && npm run build && node scripts/test.mjs"
  },
  "dependencies": {
    "astro": "7.4.5",
    "@astrojs/cloudflare": "14.4.4",
    "marked": "18.1.2",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "playwright-core": "1.58.2",
    "wrangler": "4.156.2"
  },
  "cloudflare": {
    "label": "Website",
    "bindings": {
      "ACCESS_ISSUER": {
        "description": "Cloudflare Access team URL"
      },
      "ACCESS_AUD": {
        "description": "Access application audience"
      },
      "APP_ORIGIN": {
        "description": "Application HTTPS origin"
      }
    }
  }
}
