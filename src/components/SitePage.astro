---
import { markdown } from '../lib/markdown.js';
const { document: site, page, base = '', siteID = '', demo = false, preview = false } = Astro.props;
const href = slug => preview ? '#' : (demo && !slug ? '/' : `${base}/${slug}`);
const canonical = new URL(href(page.slug), Astro.url.origin).href;
---
<!doctype html>
<html lang="en" data-theme={site.theme}>
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{page.title} · {site.name}</title><meta name="description" content={page.summary || site.tagline} />
    {preview ? <meta name="robots" content="noindex, nofollow" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={`${page.headline} · ${site.name}`} /><meta property="og:description" content={page.summary} /><meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="stylesheet" href="/styles.css" />
  </head>
  <body class="public-site">
    <a class="skip" href="#main">Skip to content</a>
    {demo && <aside class="demo-bar"><span><strong>Nexa Website</strong><span class="demo-detail"> · A working Astro template with fictional content</span></span><button data-create>Create your website <span aria-hidden="true">↗</span></button></aside>}
    {preview && <aside class="demo-bar"><strong>Draft preview</strong><span>Links and contact submissions are disabled.</span></aside>}
    <header class="site-header wrap">
      <a class="brand" href={href('')}><span class="brand-symbol" aria-hidden="true">n<span>↗</span></span>{site.name}<span class="brand-period">.</span></a>
      {!preview && <button class="menu-toggle" aria-label="Open navigation" aria-controls="site-navigation" aria-expanded="false">Menu <span aria-hidden="true">+</span></button>}
      <nav id="site-navigation" aria-label="Main navigation">{site.pages.map(item => <a href={href(item.slug)} aria-current={item.id === page.id ? 'page' : undefined}>{item.title}{item.slug === 'contact' && <span aria-hidden="true"> ↗</span>}</a>)}</nav>
    </header>
    <main id="main" class="wrap">
      <section class:list={['hero', { 'hero-home': page.slug === '', 'hero-compact': page.slug !== '' }]}>
        <div class="hero-copy"><p class="eyebrow"><span class="status-dot" />{page.eyebrow}</p><h1>{page.headline}</h1><p class="hero-summary">{page.summary}</p>
          {page.slug !== 'contact' && <div class="hero-actions"><a class="button primary" href={href('contact')}>Start a conversation <span aria-hidden="true">↗</span></a>{page.slug === '' && site.pages.some(p => p.slug === 'work') && <a class="text-link" href={href('work')}>Explore our work <span aria-hidden="true">↓</span></a>}</div>}
          {page.slug === '' && <div class="hero-footnote"><span>Considered from the outset.</span><span>Made for everyday life.</span></div>}
        </div>
        {page.slug === '' && <figure class="architecture"><img src="/architecture.svg" alt="Architectural illustration of a courtyard house with a timber facade and a sheltered garden" width="720" height="820" /><figcaption><span><small>CONCEPT STUDY / 01</small>The Courtyard House</span><span aria-hidden="true">↗</span></figcaption><span class="art-tag">Light. Space. Possibility.</span></figure>}
      </section>
      <section class:list={['content-section', { 'contact-grid': page.slug === 'contact' }]}>
        <div class="prose" set:html={markdown(page.body)} />
        {page.slug === 'contact' && <form id="contact-form" data-site={siteID}>
          <h2>A note to the studio</h2><p class="muted">{demo ? 'Create your own website to receive real enquiries.' : preview ? 'This form is disabled in preview.' : 'Your message is saved in the website owner’s private inbox.'}</p>
          <fieldset disabled={demo || preview}>
            <label>Your name<input name="name" autocomplete="name" required maxlength="100" /></label>
            <label>Email address<input name="email" type="email" autocomplete="email" required maxlength="200" /></label>
            <label>Tell us about your project<textarea name="message" rows="5" required maxlength="5000" /></label>
            <label class="honeypot" aria-hidden="true">Leave this empty<input name="website" tabindex="-1" autocomplete="off" /></label>
            <button class="primary" type="submit">Send enquiry <span aria-hidden="true">↗</span></button>
          </fieldset><p id="contact-status" role="status"></p>
        </form>}
        {page.slug === '' && <div class="service-links">{site.pages.filter(p => p.slug && p.slug !== 'contact').slice(0, 3).map((item, index) => <a href={href(item.slug)}><small>0{index + 1}</small><h2>{item.title}</h2><p>{item.summary}</p><span aria-hidden="true">↗</span></a>)}</div>}
      </section>
      {page.slug !== 'contact' && <section class="closing"><span class="eyebrow">An idea worth exploring?</span><h2>Let’s find its shape.</h2><a href={href('contact')}>Get in touch <span aria-hidden="true">↗</span></a></section>}
    </main>
    <footer class="site-footer wrap"><div><strong>{site.name}.</strong><p>{site.tagline}</p></div><div>{site.email && <a href={preview ? '#' : `mailto:${site.email}`}>{site.email}</a>}<p>© {new Date().getFullYear()} {site.name}</p><a class="small muted" href="/editor">Website editor</a></div></footer>
    <p id="site-status" class="site-status" role="status"></p>
    <script src="../scripts/public.js"></script>
  </body>
</html>
